{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DriftDetectedEvent",
  "type": "object",
  "required": [
    "event_type",
    "schema_version",
    "trace_id",
    "batch_id",
    "batch_date",
    "severity",
    "share_of_drifted_features",
    "drifted_features",
    "report_uri",
    "emitted_at"
  ],
  "properties": {
    "event_type": { "type": "string", "const": "drift.detected" },
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "trace_id": { "type": "string" },
    "batch_id": { "type": "string" },
    "batch_date": { "type": "string", "format": "date" },
    "severity": { "type": "string", "enum": ["warn", "critical"] },
    "share_of_drifted_features": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "drifted_features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["feature", "metric", "score", "threshold"],
        "properties": {
          "feature": { "type": "string" },
          "metric": { "type": "string" },
          "score": { "type": "number" },
          "threshold": { "type": "number" }
        }
      }
    },
    "prediction_drift_p_value": { "type": "number" },
    "report_uri": { "type": "string", "format": "uri" },
    "emitted_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
