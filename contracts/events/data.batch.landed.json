{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DataBatchLandedEvent",
  "type": "object",
  "required": ["event_type", "schema_version", "trace_id", "batch_id", "batch_date", "row_count", "gcs_uri", "emitted_at"],
  "properties": {
    "event_type": { "type": "string", "const": "data.batch.landed" },
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "trace_id": { "type": "string" },
    "batch_id": { "type": "string" },
    "batch_date": { "type": "string", "format": "date" },
    "row_count": { "type": "integer", "minimum": 1 },
    "gcs_uri": { "type": "string", "format": "uri" },
    "emitted_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
